{
  "name": "cribro-recall",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server.ts",
    "dev:starter:backend": "python3 -m uvicorn python_api.main:app --reload --port 8000",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild api/serverless.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "emulators": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:start --project demo-cribro --only firestore,auth",
    "test:rules": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:exec --project demo-cribro --only firestore \"tsx --test tests/rules/*.test.ts\"",
    "firebase:login": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" firebase login",
    "firebase:whoami": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" firebase login:list",
    "deploy:rules": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" firebase deploy --only functions",
    "deploy:hosting": "npm run build && PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" firebase deploy --only hosting",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/html2pdf.js": "^0.10.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "canvas-confetti": "^1.9.4",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.10.0",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "i18next": "^26.3.6",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/pdf-parse": "^1.1.5",
    "puppeteer": "^25.5.0"
  }
}
