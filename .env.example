# ---------------------------------------------------------------------------
# Klucze API — wyłącznie po stronie serwera.
# ---------------------------------------------------------------------------
# Vite wkleja każdą zmienną z przedrostkiem VITE_ wprost do bundla wysyłanego
# do przeglądarki. Klucz, za który płacisz, nie może mieć takiego przedrostka:
# w przeciwnym razie każdy odwiedzający wyjmie go z DevTools i zużyje na Twój
# rachunek. Wszystkie wywołania AI idą teraz przez /api/* na tym serwerze.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Konto usługi Firebase Admin (JSON w jednej linii). Bez niego serwer nie
# zweryfikuje tokenów i trasy /api/openai, /api/gemini/* oraz /api/tts będą
# odpowiadać 401.
FIREBASE_SERVICE_ACCOUNT=

# Konfiguracja klienta Firebase. Ta akurat jest jawna z założenia — dostępu
# pilnują reguły w firestore.rules, nie tajność klucza. Warto jednak ograniczyć
# klucz do własnych domen w konsoli Google Cloud.
VITE_FIREBASE_CONFIG=

# Origin-y, którym /api/tts wolno odpowiadać w trybie CORS (po przecinku).
# Puste = tylko własna domena, co jest właściwym ustawieniem dla produkcji.
ALLOWED_ORIGINS=
